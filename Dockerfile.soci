# syntax=docker/dockerfile:1
FROM golang:1.26.8-alpine3.23 AS daemon
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -mod=vendor -ldflags '-X github.com/moby/buildkit/version.Version=v0.34.2-soci-spike' -o /out/buildkitd ./cmd/buildkitd

FROM golang:1.26.8-alpine3.23 AS indexer
RUN apk add --no-cache git build-base zlib-dev zlib-static
RUN git clone --depth=1 --branch=v0.16.1 https://github.com/awslabs/soci-snapshotter.git /soci
WORKDIR /soci
COPY contrib/soci-ztoc/main.go ./buildkit-soci-ztoc/main.go
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=1 go build -mod=mod -tags socihelper,netgo,osusergo -ldflags '-extldflags=-static' -o /out/buildkit-soci-ztoc ./buildkit-soci-ztoc

FROM moby/buildkit:v0.34.2
COPY --from=daemon /out/buildkitd /usr/bin/buildkitd
COPY --from=indexer /out/buildkit-soci-ztoc /usr/bin/buildkit-soci-ztoc
